						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"student_id\": 1,\n    \"amount_paid\": 5000.00,\n    \"payment_mode\": \"Online\",\n    \"remarks\": \"Term 1 Exam and Tuition Fee payment\"\n}",
